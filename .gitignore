server/hls/*
!server/hls/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tunnel Binaries
cloudflared
cloudflared.exe
ngrok
ngrok.exe

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
