# Dependencies
node_modules/
*/node_modules/

# Environment Variables
.env
.env.*
!.env.example
server/.env

# Build Output
dist/
client/dist/
dist-ssr/

# Media & Transcoded Segments (Never commit movies or HLS segments)
server/media/*
